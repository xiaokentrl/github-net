// github-net 构建与发布拓扑　生成日期 2026-10-28
// 问的问题：这个二进制怎么编出来、过哪几道门、怎么到用户机器上。
// 门一/门二的判据直接抄 .github/workflows/ci.yml，未做任何推测。
// 渲染：dot -Tsvg build-release-pipeline.dot -o build-release-pipeline.svg
digraph release {
  rankdir=LR;
  nodesep=0.45; ranksep=1.0;
  fontname="Helvetica"; labelloc=t; fontsize=15;
  label="构建与发布：两条线——CI 出包过门，本机推送即重装\n（arm64、Windows、macOS 还没进门禁）";
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c8ccd1", fontsize=11];

  src [label="main 分支代码", shape=folder, fillcolor="#f2f4f6"];

  // ── CI 四条作业 ────────────────────────────────────────────────
  subgraph cluster_ci {
    label="GitHub Actions（runs-on ubuntu-latest 只是宿主 VM，不等于支持目标）"; style="rounded"; color="#d0d7de"; fontsize=12;

    fe [label="作业 1 前端构建\nubuntu-latest + node 24\nnpm ci && npm run build（先 tsc）\n产物 frontend-dist；找不到文件就报错", fillcolor="#e8f8ef"];
    be [label="作业 2 后端检查\ncontainer ubuntu:26.04\n装 gtk4/webkitgtk6.0 dev\n取回 frontend-dist → gofmt → go vet → go test -count=1", fillcolor="#eaf3ff"];
    lx [label="作业 3 Linux x64 出包 + 门一 + 门二\ncontainer ubuntu:26.04\n先放行工作目录属主（dubious ownership 会让 go build 退 1）\nCGO_ENABLED=1 go build -trimpath -o bin/github-net .\n产物名 github-net-linux-amd64", fillcolor="#eaf3ff"];
    d13 [label="作业 4 门二复核 Debian 13\ncontainer debian:13\n只装运行库 libgtk-4-1 libwebkitgtk-6.0-4\n下载作业 3 的产物再验", fillcolor="#fff8e1"];

    gate1 [label="门一：objdump -T 取产物最高 GLIBC_ 符号\n必须 ≤ 2.41", shape=diamond, fillcolor="#fdeceb"];
    gate2 [label="门二：ldd -r 无 not found / undefined\n且三个运行库 .so 都在", shape=diamond, fillcolor="#fdeceb"];

    fe -> be [label="needs + 制品"];
    fe -> lx [label="needs + 制品"];
    lx -> gate1 -> gate2 -> d13 [label="needs"];
  }

  // ── 目标环境与产物 ─────────────────────────────────────────────
  subgraph cluster_target {
    label="支持目标（实测口径见 TECHNICAL_PLAN）"; style="rounded"; color="#d0d7de"; fontsize=12;
    ubuntu [label="Ubuntu 26.04\n构建宿主 = 同一发行版容器", fillcolor="#f6f8fa"];
    debian [label="Debian 13\n只验运行库，不在这里编", fillcolor="#f6f8fa"];
    unknown [label="实机 / arm64 / Windows / macOS\n未验，未进门禁", fillcolor="#f2f4f6", fontcolor="#8a94a0", style="rounded,dashed"];
  }
  gate2 -> ubuntu; d13 -> debian;

  // ── 打包 ──────────────────────────────────────────────────────
  subgraph cluster_pkg {
    label="打包（只在本地链上跑：ci.yml 里没有任何打包作业）"; style="dashed"; color="#8a94a0"; fontsize=12;
    task [label="Taskfile.yml：build/package/run 按 GOOS 分派\nbuild/linux/Taskfile.yml build:native 或 build:docker\n（无 C 编译器或非本机架构时走 wails-cross 镜像）", fillcolor="#f6f8fa"];
    nfpm [label="wails3 tool package -config ./build/linux/nfpm/nfpm.yaml（Taskfile:153-166，deb/rpm/aur 各一条）\nnfpm.yaml 装 3 个文件：二进制、128x128 图标、桌面项（dst 在 :21-25）\ndepends libgtk-4-1、libwebkitgtk-6.0-4；只挂 postinstall（刷 desktop + mime 两个库）", fillcolor="#f6f8fa"];
    desktop [label="桌面项是构建产物、又入了库：generate:dotdesktop 每次重新生成同名文件（Taskfile:171-177）\nName/Icon 取 APP_NAME（字面量 github-net），StartupWMClass 取 DESKTOP_ID 字面量\n模板残留：Keywords=wails、Categories=Development;、nfpm homepage=https://wails.io", fillcolor="#f6f8fa"];
    task -> desktop [label="generate:dotdesktop 先重新生成（:171-177）"];
    desktop -> nfpm [label="作为 contents 装进包"];
    task -> nfpm [label="generate:deb（:153-156）"];
  }
  src -> task [label="出包只由开发者本机触发（ci.yml 里没有打包作业）", style=dotted, color="#8a94a0", fontcolor="#57606a"];

  // ── 本机推送即重装 ────────────────────────────────────────────
  subgraph cluster_push {
    label="开发者本机：git push 触发（GITHUB_NET_SKIP_REINSTALL=1 可跳过一次；当前 core.hooksPath 实跑确认 = .githooks）"; style="dashed"; color="#8a94a0"; fontsize=12;
    hook [label=".githooks/pre-push\n→ scripts/pre-push-reinstall.sh\n任何一步失败就中断推送", fillcolor="#fff8e1"];
    guard [label="scripts/lib/identity-guard.sh\neval 一次 go run ./cmd/identity --shell\n删除/卸载动作之前必过空值门与形状门（:58 起）", fillcolor="#f3eefc"];
    mkdeb [label="出包：wails3 task linux:create:deb\n（pre-push-reinstall.sh:80）", fillcolor="#f6f8fa"];
    stopp [label="停旧进程：pkill -x 二进制名\n装着的和 wails3 dev 起的同名，一并停（:90）", fillcolor="#f6f8fa"];
    helper [label="卸装：dpkg --purge 旧包 → apt-get install -y ./新 deb\n走免密助手 github-net-root-install.sh:37,39，没助手才本地逐条执行（:70-76）\n用 apt 而不是 dpkg -i：缺依赖它自己补\n提权通道按 免密 sudo -n → 终端 sudo -v → 图形 askpass sudo -A 依次挑（setup_priv，:21-45）\n只有「读不到密码」才换弹框，密码错或被拒直接中断", fillcolor="#fdeceb"];
    wipe [label="删配置：rm -rf 三个用户目录\nshare/cache/config 下的 DataDir（:99，删前再过一次空值门 :98）\n顺序在装好之后，不会出现「配置已删、包没装」的半截状态", fillcolor="#fdeceb"];
    bin [label="用户机器上的 /usr/local/bin/github-net\n新包从默认配置起步", shape=cylinder, fillcolor="#eef3fb"];
    hook -> guard -> mkdeb -> stopp -> helper -> wipe -> bin;
  }
  src -> fe [label="push / PR 触发"];
  src -> hook [label="git push（本地钩子）", style=dotted];

  // ── 发版文档 ──────────────────────────────────────────────────
  notes [label="scripts/gen-release-notes.sh\nRelease 正文固定三组、1.2.3. 编号\n条目清单在 docs/release-notes/版本号.entries\nscripts/version.sh 定版", shape=note, fillcolor="#f6f8fa"];
  bin -> notes [style=dotted, color="#8a94a0", fontcolor="#57606a", label="当前实测 0 个 release、0 个标签"];

  identity [label="internal/identity\n身份字面量的唯一手写源\n（Taskfile/nfpm 接线仍等落句）", shape=note, fillcolor="#f3eefc", fontcolor="#5b3a8e"];
  identity -> guard [style=dotted, color="#6f42c1"];
  identity -> nfpm [style=dashed, color="#6f42c1", fontcolor="#5b3a8e", label="缺口：仍是抄写"];
}
