[Unit]
Description=GitHub Net 特权辅助服务（唯一被允许写系统 Hosts 的那一个）
Documentation=https://github.com/xiaokentrl/github-net
# 界面（github-net）随时来连，不依赖网络就绪；还原和应用只动本地文件。

[Service]
Type=simple
# 恢复元数据与备份钉在 /var/opt/github-net（FHS：/opt 包的可变数据归 /var/opt）；
# 系统服务没有 HOME/XDG 变量，不钉则备份写不进固定位置。路径单源见 internal/identity。
ExecStart=/opt/github-net/libexec/github-net-helper -hosts /etc/hosts -data /var/opt/github-net
# root 常驻〔沿用 2026-10-25 拍板的权限模型〕——写 /etc/hosts 本来就要这一档。
# socket 访问由内核把关：RuntimeDirectory 建 /run/github-net，helper 把 socket
# chmod 0660 chown root:github-net——组内进程才能 connect（0666 模型已退役）。
# 目录 0755 而非 0750：app 用户要能走到 socket 前；真正的门在 socket 的 0660 上。
RuntimeDirectory=github-net
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
# 沙箱：strict＝全盘只读，ReadWritePaths 白名单放行两个写点——
# 注意白名单必须放「目录」而不是单个文件：helper 的写流程要在 /etc 里建临时文件
# 再 rename 替换（真机教训 2026-11-15：放行文件级 /etc/hosts 盖不住 /etc 目录操作，
# 建临时文件被 EROFS 拒；改 ProtectSystem=full 也无效——full 同样把 /etc 只读化）。
# NoNewPrivileges 防 helper 被诱导再提权；PrivateTmp 隔离临时目录。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/opt/github-net /etc

[Install]
WantedBy=multi-user.target
