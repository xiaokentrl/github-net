<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="github-net"
        Arguments=""
        InstallLocation="C:\Program Files\xiaokentrl\GitHub Net">
    </Installer>
    <PackageInformation
        PackageName="GitHub Net"
        PackageDisplayName="GitHub Net"
        PublisherName="CN=xiaokentrl"
        PublisherDisplayName="xiaokentrl"
        Version="0.1.0.0"
        PackageDescription="GitHub 和 Steam 网络加速工具">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.xiaokentrl.githubnet"
                Description="GitHub 和 Steam 网络加速工具"
                DisplayName="GitHub Net"
                ExecutableName="github-net"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GitHub Net</DisplayName>
            <PublisherDisplayName>xiaokentrl</PublisherDisplayName>
            <Description>GitHub 和 Steam 网络加速工具</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="github-net.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
